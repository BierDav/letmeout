// Target-specific content and rules, in the style of the `bullseye` package.
// `show-target` leaves a marker next to its context fallback, so `letmeout`
// can apply the HTML rule directly and see the page set rules inside it. A
// context block would hide them.
#let marker-label = <letmeout-target>

// Content for one target. Absent targets show nothing.
#let on-target(html: none, paged: none) = context {
  if target() == "html" { html } else { paged }
}

// A show rule for one target: `#show: show-target(html: body => ...)`.
// Absent targets leave the content unchanged.
#let show-target(html: body => body, paged: body => body) = body => {
  [#metadata((html: html, body: body))#marker-label]
  context { if target() == "html" { html(body) } else { paged(body) } }
}

// The default of every `html-page` parameter: not given, so the surrounding
// page setting stays. `none` and `auto` are page settings of their own.
#let inherit = metadata(<letmeout-inherit>)

// The rule behind `html-page`, with the parameters that were given.
#let html-page-rule(settings) = {
  let given = settings.pairs().filter(((_, value)) => value != inherit).to-dict()
  show-target(html: body => { set page(..given); body })
}

// Generated by scripts/api-docs.py from the Typst 0.15.1 docs of `page`,
// https://typst.app/docs/reference/layout/page/. Edit scripts/api.toml, not this block.
/// Page settings for HTML only, as a show rule: `#show: html-page(margin: 1em)`.
///
/// It works like a `#set page(..)` that only HTML export sees: it applies to the rest
/// of the scope, changes only the settings it names, and a later `set page` overrides
/// it, also in HTML. Paged output ignores it. It needs `#show: letmeout` at the top of
/// the document.
///
/// The parameters are those of Typst's `page`, with Typst's docs. A parameter that is
/// not given keeps the surrounding page setting.
///
/// - paper (str): A standard paper size to set width and height.
///
///   This is just a shorthand for setting `width` and `height` and, as such, cannot be
///   retrieved in a context expression.
///
///   Default: the surrounding page setting; Typst's default is `"a4"`.
///
///   **In HTML:** Sets the width of the sheet. HTML has no page height.
///
/// - width (auto, length): The width of the final page, after any trims have been
///   applied.
///
///   In professional printing setups, this may be smaller than the sheet size fed into
///   the printer.
///
///   See the `bleed` parameter for details on how to set a trim or bleed area.
///
///   Default: the surrounding page setting; Typst's default is `595.28pt`.
///
///   **In HTML:** The maximum width of the centred sheet. Narrower screens show a
///   narrower sheet. `auto` fills the screen.
///
/// - height (auto, length): The height of the final page area, after any trims have
///   been applied.
///
///   If this is set to `auto`, page breaks can only be triggered manually by inserting
///   a page break or by adding another non-empty page set rule. Most examples
///   throughout this documentation use `auto` for the height of the page to dynamically
///   grow and shrink to fit their content.
///
///   Default: the surrounding page setting; Typst's default is `841.89pt`.
///
///   **In HTML:** No effect. The block is as tall as its content.
///
/// - flipped (bool): Whether the page is flipped into landscape orientation.
///
///   Default: the surrounding page setting; Typst's default is `false`.
///
///   **In HTML:** Swaps width and height, so it changes the width of the sheet.
///
/// - margin (auto, relative, dictionary): The page’s margins.
///
///   - `auto`: The margins are set automatically to 2.5/21 times the smaller dimension
///     of the page. This results in 2.5 cm margins for an A4 page.
///   - A single length: The same margin on all sides.
///   - A dictionary: With a dictionary, the margins can be set individually. The
///     dictionary can contain the following keys in order of precedence:
///     - `top`: The top margin.
///     - `right`: The right margin.
///     - `bottom`: The bottom margin.
///     - `left`: The left margin.
///     - `inside`: The margin at the inner side of the page (where the binding is).
///     - `outside`: The margin at the outer side of the page (opposite to the binding).
///     - `x`: The horizontal margins.
///     - `y`: The vertical margins.
///     - `rest`: The margins on all sides except those for which the dictionary
///       explicitly sets a size.
///
///   All keys are optional; omitted keys will use their previously set value, or the
///   default margin if never set. In addition, the values for `left` and `right` are
///   mutually exclusive with the values for `inside` and `outside`. The values should
///   be relative lengths or `auto`.
///
///   Default: the surrounding page setting; Typst's default is `auto`.
///
///   **In HTML:** Padding inside the sheet. With a fixed width, margins scale with the
///   sheet: they equal the given length at full width and shrink on narrow screens.
///
/// - bleed (relative, dictionary): The page’s bleed margin.
///
///   The bleed is the area of content that extends beyond the final trimmed size of the
///   page. It ensures that no unprinted edges appear in the final product, even if
///   minor trimming misalignments occur.
///
///   Accepted values:
///
///   - A single length: The same bleed on all sides.
///   - A dictionary: With a dictionary, the bleed margins can be set individually. The
///     dictionary may include the following keys, listed in order of precedence:
///     - `top`: The top bleed margin.
///     - `right`: The right bleed margin.
///     - `bottom`: The bottom bleed margin.
///     - `left`: The left bleed margin.
///     - `inside`: The bleed margin at the inner side of the page (where the binding
///       is).
///     - `outside`: The bleed margin at the outer side of the page (opposite to the
///       binding).
///     - `x`: The horizontal bleed margins.
///     - `y`: The vertical bleed margins.
///     - `rest`: The bleed margins on all sides except those for which the dictionary
///       explicitly sets a size.
///
///   All keys are optional; omitted keys will use their previously set value, or `0pt`
///   if never set. In addition, the values for `left` and `right` are mutually
///   exclusive with the values for `inside` and `outside`. The values should be
///   relative lengths.
///
///   In PDF export, if the bleed is non-zero, a `TrimBox` is defined for the page.
///
///   Default: the surrounding page setting; Typst's default is `(:)`.
///
///   **In HTML:** No effect.
///
/// - binding (auto, alignment): On which side the pages will be bound.
///
///   - `auto`: Equivalent to `left` if the text direction is left-to-right and `right`
///     if it is right-to-left.
///   - `left`: Bound on the left side.
///   - `right`: Bound on the right side.
///
///   This affects the meaning of the `inside` and `outside` options for margins.
///
///   Default: the surrounding page setting; Typst's default is `auto`.
///
///   **In HTML:** Decides which side the `inside` margin is on. A screen shows one
///   page, so this is the first page's side.
///
/// - columns (int): How many columns the page has.
///
///   If you need to insert columns into a page or other container, you can also use the
///   `columns` function.
///
///   Default: the surrounding page setting; Typst's default is `1`.
///
///   **In HTML:** CSS columns, at least `12em` wide, so they collapse into one on
///   narrow screens.
///
/// - fill (none, auto, color, gradient, tiling): The page’s background fill.
///
///   Setting this to something non-transparent instructs the printer to color the
///   complete page. If you are considering larger production runs, it may be more
///   environmentally friendly and cost-effective to source pre-dyed pages and not set
///   this property.
///
///   When set to `none`, the background becomes transparent. Note that PDF pages will
///   still appear with a (usually white) background in viewers, but they are actually
///   transparent. (If you print them, no color is used for the background.)
///
///   The default of `auto` results in `none` for PDF output, and `white` for PNG and
///   SVG.
///
///   Default: the surrounding page setting; Typst's default is `auto`.
///
///   **In HTML:** Background of the full-width block. `auto` is transparent, so the
///   site's colours show through.
///
/// - numbering (none, str, function): How to number the pages. You can refer to the
///   Page Setup Guide for customizing page numbers.
///
///   Accepts a numbering pattern or function taking one or two numbers:
///
///   1. The first number is the current page number.
///   2. The second number is the total number of pages. In a numbering pattern, the
///      second number can be omitted. If a function is passed, it will receive one
///      argument in the context of links or references, and two arguments when
///      producing the visible page numbers.
///
///   These are logical numbers controlled by the page counter, and may thus not match
///   the physical numbers. Specifically, they are the current and the final value of
///   `counter(page)`. See the `counter` documentation for more details.
///
///   If an explicit `footer` (or `header` for top-aligned numbering) is given, the
///   numbering is ignored.
///
///   Default: the surrounding page setting; Typst's default is `none`.
///
///   **In HTML:** Shown in the automatic header or footer. The page counter does not
///   advance: the HTML is one page.
///
/// - supplement (none, auto, content): A supplement for the pages.
///
///   For page references, this is added before the page number.
///
///   Default: the surrounding page setting; Typst's default is `auto`.
///
///   **In HTML:** No effect on screen.
///
/// - number-align (alignment): The alignment of the page numbering.
///
///   If the vertical component is `top`, the numbering is placed into the header and if
///   it is `bottom`, it is placed in the footer. Horizon alignment is forbidden. If an
///   explicit matching `header` or `footer` is given, the numbering is ignored.
///
///   Default: the surrounding page setting; Typst's default is `center + bottom`.
///
///   **In HTML:** Places the automatic number in the header or the footer.
///
/// - header (none, auto, content): The page’s header. Fills the top margin of each
///   page.
///
///   - Content: Shows the content as the header.
///   - `auto`: Shows the page number if a `numbering` is set and `number-align` is
///     `top`.
///   - `none`: Suppresses the header.
///
///   Default: the surrounding page setting; Typst's default is `auto`.
///
///   **In HTML:** A `<header>` before the content, once per block.
///
/// - header-ascent (relative): The amount the header is raised into the top margin.
///   Ratios are relative to the height of the top margin.
///
///   Default: the surrounding page setting; Typst's default is `30% + 0pt`.
///
///   **In HTML:** Space between the header and the content.
///
/// - footer (none, auto, content): The page’s footer. Fills the bottom margin of each
///   page.
///
///   - Content: Shows the content as the footer.
///   - `auto`: Shows the page number if a `numbering` is set and `number-align` is
///     `bottom`.
///   - `none`: Suppresses the footer.
///
///   For just a page number, the `numbering` property typically suffices. If you want
///   to create a custom footer but still display the page number, you can directly
///   access the page counter.
///
///   Default: the surrounding page setting; Typst's default is `auto`.
///
///   **In HTML:** A `<footer>` after the content, once per block.
///
/// - footer-descent (relative): The amount the footer is lowered into the bottom
///   margin. Ratios are relative to the height of the bottom margin.
///
///   Default: the surrounding page setting; Typst's default is `30% + 0pt`.
///
///   **In HTML:** Space between the content and the footer.
///
/// - background (none, content): Content in the page’s background.
///
///   This content will be placed behind the page’s body. It can be used to place a
///   background image or a watermark.
///
///   For convenience, relative lengths are resolved against the page size including the
///   page `bleed` when used in background content. For example, on a page that is
///   `100mm` wide with a `5mm` bleed, a width of `100%` is computed as `5mm + 100mm +
///   5mm`.
///
///   Default: the surrounding page setting; Typst's default is `none`.
///
///   **In HTML:** A layer behind the content, hidden from screen readers.
///
/// - foreground (none, content): Content in the page’s foreground.
///
///   This content will overlay the page’s body.
///
///   Relative lengths are resolved against the page size including `bleed`, following
///   the same behavior as `background`.
///
///   Default: the surrounding page setting; Typst's default is `none`.
///
///   **In HTML:** A layer above the content, hidden from screen readers. It does not
///   catch clicks.
///
/// -> function
#let html-page(
  paper: inherit,
  width: inherit,
  height: inherit,
  flipped: inherit,
  margin: inherit,
  bleed: inherit,
  binding: inherit,
  columns: inherit,
  fill: inherit,
  numbering: inherit,
  supplement: inherit,
  number-align: inherit,
  header: inherit,
  header-ascent: inherit,
  footer: inherit,
  footer-descent: inherit,
  background: inherit,
  foreground: inherit,
) = html-page-rule((
  paper: paper,
  width: width,
  height: height,
  flipped: flipped,
  margin: margin,
  bleed: bleed,
  binding: binding,
  columns: columns,
  fill: fill,
  numbering: numbering,
  supplement: supplement,
  number-align: number-align,
  header: header,
  header-ascent: header-ascent,
  footer: footer,
  footer-descent: footer-descent,
  background: background,
  foreground: foreground,
))

#let is-marker(it) = (repr(it.func()) == "metadata" and it.has("label")
  and it.label == marker-label)

// `#show: letmeout` calls this on the document in HTML. It applies each HTML
// rule left by `show-target` directly and drops its context fallback, so the
// page settings inside become visible. Markers deeper inside other elements
// keep working through the fallback.
#let resolve(it) = {
  let k = repr(it.func())
  if k == "sequence" {
    let children = ()
    let rest = it.children
    while rest.len() > 0 {
      let child = rest.remove(0)
      if is-marker(child) and rest.len() > 0 and repr(rest.first().func()) == "context" {
        let _ = rest.remove(0)
        children.push(resolve((child.value.html)(child.value.body)))
      } else { children.push(resolve(child)) }
    }
    return children.sum(default: [])
  }
  if k == "styled" { return it.func()(resolve(it.child), it.styles) }
  it
}
